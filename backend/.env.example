# ── Gmail SMTP Setup ─────────────────────────────────────────────
# Step 1: Enable 2-Factor Authentication on your Gmail account
# Step 2: Go to https://myaccount.google.com/apppasswords
# Step 3: Generate an App Password (select Mail + Windows Computer)
# Step 4: Paste the 16-character password below (without spaces)

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=asifbeta69@gmail.com
SMTP_PASSWORD=your-16-character-app-password-here

# ── Doctor Notification ───────────────────────────────────────────
# This is the email address where appointment notifications are sent
DOCTOR_EMAIL=asifbeta@gmail.com
DOCTOR_NAME=Dr. Rana Humayun Babar
CLINIC_NAME=Wajid ENT Clinic
CLINIC_PHONE=0309-8742674

# ── App ───────────────────────────────────────────────────────────
# Change to your actual domain in production
FRONTEND_URL=http://localhost:8000
DEBUG=false
